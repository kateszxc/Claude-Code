# Copy to .env and fill in what you have. Everything is optional.

# --- Brand discovery (search) ---
# Recommended: Brave Search API (free tier available) https://brave.com/search/api/
BRAVE_API_KEY=
# Alternative: SerpAPI (Google results) https://serpapi.com/
SERPAPI_KEY=
# With neither key set, the scraper falls back to DuckDuckGo's HTML results,
# which work for small runs but may get rate-limited.

# --- Founder emails ---
# Hunter.io domain search adds verified founder/CEO emails https://hunter.io/api
HUNTER_API_KEY=

# --- AI summaries & improvement ideas ---
# When set, Claude writes the "what they're about" summary and tailored
# marketing / website / brand improvement ideas.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Tuning ---
SCRAPER_CONCURRENCY=6
SCRAPER_TIMEOUT_SECONDS=15
# Comma-separated origins allowed to call the API (the Next.js dev server by default)
CORS_ORIGINS=http://localhost:3000
